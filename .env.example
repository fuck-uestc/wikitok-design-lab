# npm run setup generates independent admin and MCP credentials.
# Existing installations: npm run setup -- --upgrade (preserves existing values).
NODE_ENV=development
SITE_NAME="校园 BBS Wiki"
SITE_DESCRIPTION="把校园里的故事、经验和共同记忆，慢慢收藏。"
SITE_TAGLINE="校园有回声，记忆有来处。"
SITE_SHORT_NAME="校园志"
DEFAULT_THEME=margin
# Initial feed settings only. Once saved in the admin UI, SQLite takes precedence.
DEFAULT_FEED=main
# Leave blank for main (mixed), wiki (long), slices (short).
FEEDS_JSON=
PUBLIC_SITE_URL=http://localhost:5173
# Browser-visible API prefix. Same origin is recommended in production.
PUBLIC_API_BASE_URL=/api
BBS_BASE_URL=
BBS_THREAD_URL_TEMPLATE=
CONTACT_EMAIL=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
FRONTEND_PORT=5173
DEV_API_TARGET=http://127.0.0.1:3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact number of trusted reverse proxies; leave 0 without a proxy.
TRUST_PROXY=0

# Relative paths resolve from the project root, never from a browser URL.
DATABASE_PATH=./data/wiki.sqlite
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
ADMIN_USERNAME=admin
# Required only to bootstrap/reset an admin. Minimum 12 characters.
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
MAX_UPLOAD_MB=10
MAX_IMPORT_MB=5
IMPORT_MAX_RECORDS=500

# MCP endpoint: /mcp. Tokens must be distinct, 32-256 chars, no whitespace.
# Write token can read private drafts and modify/archive/publish entries.
MCP_TOKEN=
# Optional read-only management token; it can read drafts, not just public data.
MCP_READ_TOKEN=
# Enable only when intentionally using the administrator password as Bearer.
# Legacy deployments without either MCP token retain that compatibility.
MCP_ALLOW_ADMIN_PASSWORD=false
